{
  "compilerOptions": {
    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Environment Settings */
    "module": "commonjs",
    "target": "es2020",
    "lib": ["esnext"],
    "types": ["node"],
    "typeRoots": [
      "./node_modules/@types", 
      "./types"              
    ],
    "moduleResolution": "node",

    /* Import Fixes */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Outputs */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Performance */
    "skipLibCheck": true
  },
  "include": ["src/**/*","types"],
  "exclude": ["node_modules", "dist"]
}
